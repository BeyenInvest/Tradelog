{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tsbuildcache",
    "strict": true
  },
  "include": ["vite.config.ts"]
}
