{
  "manifest_version": 3,
  "name": "Beyen voor TradingView (beta)",
  "version": "0.2.8",
  "description": "Log je TradingView-trades in je Beyen-journal: prijzen uit je position-tool en snapshots per timeframe.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": ["https://*.tradingview.com/*"],
  "background": { "service_worker": "dist/sw.js", "type": "module" },
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://*.tradingview.com/chart/*"],
      "js": ["dist/content/tvMain.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.tradingview.com/chart/*"],
      "js": ["dist/content/bridge.js", "dist/content/panel.js"],
      "run_at": "document_idle"
    }
  ]
}
